generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Рантайм: подключение через пулер (важно для serverless на Vercel)
  url       = env("DATABASE_URL")
  // Схема и миграции: только прямое подключение
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  IN_STOCK
  ON_ORDER
  OUT_OF_STOCK
}

model Admin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id               Int           @id @default(autoincrement())
  name             String
  slug             String        @unique
  shortDescription String?       @map("short_description")
  description      String?
  price            Int?
  oldPrice         Int?          @map("old_price")
  categoryId       Int?          @map("category_id")
  status           ProductStatus @default(IN_STOCK)
  isActive         Boolean       @default(true) @map("is_active")
  isFeatured       Boolean       @default(false) @map("is_featured")
  isNew            Boolean       @default(false) @map("is_new")
  isSale           Boolean       @default(false) @map("is_sale")
  showOnHome       Boolean       @default(false) @map("show_on_home")
  keywords         String?
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  attributes ProductAttribute[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  imageUrl  String  @map("image_url")
  sortOrder Int     @default(0) @map("sort_order")
  isMain    Boolean @default(false) @map("is_main")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductAttribute {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  name      String
  value     String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

model SiteSetting {
  key   String @id
  value String @default("")

  @@map("site_settings")
}

model HomeContent {
  id Int @id @default(1)

  heroTitle       String @default("") @map("hero_title")
  heroAccent      String @default("") @map("hero_accent")
  heroSubtitle    String @default("") @map("hero_subtitle")
  heroText        String @default("") @map("hero_text")
  heroImage       String @default("") @map("hero_image")
  heroButtonText  String @default("Смотреть каталог") @map("hero_button_text")

  aboutTitle String @default("") @map("about_title")
  aboutText  String @default("") @map("about_text")
  aboutImage String @default("") @map("about_image")
  aboutStat1Value String @default("") @map("about_stat1_value")
  aboutStat1Label String @default("") @map("about_stat1_label")
  aboutStat2Value String @default("") @map("about_stat2_value")
  aboutStat2Label String @default("") @map("about_stat2_label")
  aboutStat3Value String @default("") @map("about_stat3_value")
  aboutStat3Label String @default("") @map("about_stat3_label")

  ctaTitle String @default("") @map("cta_title")
  ctaText  String @default("") @map("cta_text")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("home_content")
}

model Advantage {
  id        Int     @id @default(autoincrement())
  title     String
  text      String  @default("")
  icon      String  @default("shield")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("advantages")
}
