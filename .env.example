# ---------- База данных ----------
# Рантайм: строка ЧЕРЕЗ ПУЛЕР (в хосте есть -pooler). На Vercel это обязательно.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Схема и миграции: ПРЯМОЕ подключение (без -pooler).
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ---------- Авторизация администратора ----------
AUTH_SECRET="длинная-случайная-строка"

# ---------- Адрес сайта ----------
# Подставляется в ссылку на товар внутри сообщения WhatsApp.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Первый администратор (используется только сидами) ----------
ADMIN_EMAIL="admin@site.kz"
ADMIN_PASSWORD="admin12345"

# ---------- Хранилище фотографий ----------
# Пусто — фото сохраняются в public/uploads (подходит для localhost и своего сервера).
# Задан — фото уходят в Vercel Blob (обязательно для Vercel: там диск только для чтения).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
